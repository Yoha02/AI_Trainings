# Reference only: set these variables in your terminal before starting Jupyter.
LAB_BACKEND=vertex
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash-lite
# Alternative: LAB_BACKEND=gemini with a Gemini Developer API key.
GEMINI_API_KEY=
# Optional: leave blank to use local, in-memory Qdrant.
QDRANT_URL=
QDRANT_API_KEY=
